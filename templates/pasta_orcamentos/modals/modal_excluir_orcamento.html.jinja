<!-- ========================================================== -->
<!-- MODAL INATIVAR ORÇAMENTO                                   -->
<!-- ========================================================== -->
<div class="orc-modal-overlay-excluir" id="modalExcluirOrcamento">
    <div class="orc-modal-box-excluir">

        <span class="orc-modal-excluir-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </span>

        <h3 class="orc-modal-excluir-title" id="modalExcluirTitulo">Inativar orçamento</h3>

        <p class="orc-modal-excluir-message" id="modalExcluirTexto">
            Tem certeza que deseja inativar o orçamento <strong id="nomeOrcamentoExcluir"></strong>?
        </p>
        <p class="orc-modal-excluir-aviso">Você poderá reativá-lo depois.</p>

        <div class="orc-modal-excluir-footer">
            <button type="button"
                    class="orc-btn-excluir-cancelar"
                    id="btnCancelarExcluirOrcamento">
                Cancelar
            </button>
            <button type="button"
                    class="orc-btn-excluir-confirmar"
                    id="btnConfirmarExcluirOrcamento">
                <i class="bi bi-trash"></i> Inativar
            </button>
        </div>

    </div>
</div>