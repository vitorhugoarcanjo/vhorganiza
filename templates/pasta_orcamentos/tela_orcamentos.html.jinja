<!-- templates/pasta_orcamentos/tela_orcamentos.html.jinja -->
{% extends "tela_base_pos_login/base.html" %}

{% block title %}Orçamentos - Gestão de Orçamentos{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ static_v('css/modules/pasta_orcamentos/orcamento.min.css') }}">
{% endblock %}

{% block content %}
<div class="painel-container">

    <div class="painel-topo-fixo">
        <form
            id="form-filtros-orcamentos"
            hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
            hx-target="#tabela-container"
            hx-swap="outerHTML"
            hx-sync="this:replace"
            hx-indicator="#orc-loading"
            hx-trigger="submit, change delay:400ms from:.filter-auto"
            style="position: relative;">

            <div class="filtros-container">

                <!-- FILTROS DA DATA -->
                <div class="bloco-filtro">
                    <div class="bloco-titulo">📅 DATA</div>

                    <div class="flex-row gap-1">
                        <button type="button"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"tipo_filtro": "ontem"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace"
                                class="btn-pure flex-fill">-1 DIA</button>

                        <button type="button"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"tipo_filtro": "hoje"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace"
                                class="btn-pure btn-success-pure flex-fill">HOJE</button>

                        <button type="button"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"tipo_filtro": "amanha"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace"
                                class="btn-pure flex-fill">+1 DIA</button>
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 2px;">
                        <button type="button"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"tipo_filtro": "mes_passado"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace"
                                class="btn-pure flex-fill">-1 MÊS</button>

                        <button type="button"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"tipo_filtro": "mes"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace"
                                class="btn-pure btn-info-pure flex-fill">I/F - MÊS</button>

                        <button type="button"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"tipo_filtro": "mes_proximo"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace"
                                class="btn-pure flex-fill">+1 MÊS</button>
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 3px;">
                        <div class="flex-fill">
                            <input type="date" name="data_inicio" id="data_inicio_input_orc"
                                class="form-control filter-auto"
                                value="{{ data_inicio or '' }}">
                        </div>
                        <div class="flex-fill">
                            <input type="date" name="data_fim" id="data_fim_input_orc"
                                class="form-control filter-auto"
                                value="{{ data_fim or '' }}">
                        </div>
                    </div>
                </div>

                <!-- STATUS -->
                <div class="bloco-filtro">
                    <div class="bloco-titulo">📊 STATUS</div>
                    <select name="status" class="form-select filter-auto">
                        <option value=""           {% if status == '' %}selected{% endif %}>Todos</option>
                        <option value="rascunho"   {% if status == 'rascunho' %}selected{% endif %}>📝 Rascunho</option>
                        <option value="enviado"    {% if status == 'enviado' %}selected{% endif %}>📤 Enviado</option>
                        <option value="aprovado"   {% if status == 'aprovado' %}selected{% endif %}>✅ Aprovado</option>
                        <option value="rejeitado"  {% if status == 'rejeitado' %}selected{% endif %}>❌ Rejeitado</option>
                    </select>
                </div>

                <!-- CLIENTE -->
                <div class="bloco-filtro">
                    <div class="bloco-titulo">👤 CLIENTE</div>
                    <input type="text" name="cliente"
                        class="form-control filter-auto"
                        placeholder="buscar cliente..."
                        value="{{ cliente or '' }}"
                        hx-trigger="input changed delay:300ms, search">
                </div>

                <!-- FILTRO ATIVAS/INATIVAS/TODAS -->
                <div class="bloco-filtro">
                    <div class="bloco-titulo">📋 ORÇAMENTO</div>
                    <div class="flex-row gap-1" id="botoes-orcamento">
                        <button type="button"
                                class="btn-filter flex-fill {% if mostrar_inativas == '0' %}btn-active-toggle{% endif %}"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"mostrar_inativas": "0"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace">Ativos</button>

                        <button type="button"
                                class="btn-filter flex-fill {% if mostrar_inativas == '1' %}btn-active-toggle{% endif %}"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"mostrar_inativas": "1"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace">Inativos</button>

                        <button type="button"
                                class="btn-filter flex-fill {% if mostrar_inativas == '2' %}btn-active-toggle{% endif %}"
                                hx-post="{{ url_for('orcamentos.ini_orcamento') }}"
                                hx-vals='{"mostrar_inativas": "2"}'
                                hx-include="#form-filtros-orcamentos"
                                hx-target="#tabela-container"
                                hx-swap="outerHTML"
                                hx-sync="this:replace">Todos</button>
                    </div>
                </div>

                <!-- BUSCA -->
                <div class="bloco-filtro bloco-pesquisa-fim">
                    <div>
                        <div class="bloco-titulo">🔍 BUSCA</div>
                        <input type="text" name="busca"
                            class="form-control filter-auto"
                            placeholder="título ou cliente..."
                            value="{{ busca or '' }}"
                            hx-trigger="input changed delay:300ms, search">
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 6px;">
                        <a href="{{ url_for('orcamentos.limpar_filtros') }}"
                        class="btn-pure flex-fill" style="text-align: center;">
                            Limpar Todos
                        </a>
                        <button type="submit" class="btn-pure btn-primary-pure flex-fill">
                            Consultar
                        </button>
                    </div>
                </div>

            </div>

            <div id="orc-loading" class="htmx-indicator">
                <div class="spinner-mini"></div>
            </div>

            <input type="hidden" name="mostrar_inativas" id="mostrar_inativas_input" value="{{ mostrar_inativas }}">
        </form>
    </div>

    <!-- TABELA -->
    {% include 'pasta_orcamentos/_tabela_orcamentos.html.jinja' %}

</div>

<!-- FOOTER FIXO -->
<div class="footer-fixo-padrao">
    <div class="botoes-footer-padrao">
        <button type="button"
                class="btn-footer btn-footer-primary"
                onclick="abrirModalNovoOrcamento()">
            <i class="bi bi-plus-lg"></i>
            <span>NOVO</span>
        </button>
    </div>

    <div>
        <h2>ORÇAMENTOS</h2>
    </div>

    <div class="totalizador-footer-padrao">
        <div class="total-item-footer">
            <label>📄 TOTAL</label>
            <span id="totalOrcamentos">{{ contadores.total if contadores else 0 }}</span>
        </div>
        <div class="total-item-footer" style="color: #f59e0b;">
            <label>📝 RASCUNHO</label>
            <span id="totalRascunho">{{ contadores.rascunho if contadores else 0 }}</span>
        </div>
        <div class="total-item-footer" style="color: #2563eb;">
            <label>📤 ENVIADO</label>
            <span id="totalEnviado">{{ contadores.enviado if contadores else 0 }}</span>
        </div>
        <div class="total-item-footer" style="color: #22c55e;">
            <label>✅ APROVADO</label>
            <span id="totalAprovado">{{ contadores.aprovado if contadores else 0 }}</span>
        </div>
        <div class="total-item-footer" style="color: #ef4444;">
            <label>❌ REJEITADO</label>
            <span id="totalRejeitado">{{ contadores.rejeitado if contadores else 0 }}</span>
        </div>
        <div class="contador-footer">
            <i class="bi bi-list-ul"></i>
            <span>{{ orcamentos|length }} orçamentos</span>
        </div>
    </div>
</div>

<!-- MODAIS -->
{% include 'pasta_orcamentos/modals/modal_novo_orcamento.html.jinja' %}
{% include 'pasta_orcamentos/modals/modal_excluir_orcamento.html.jinja' %}
{% include 'pasta_orcamentos/modals/modal_editar_orcamento.html.jinja' %}
{% include 'pasta_orcamentos/modals/modal_reativar_orcamento.html.jinja' %}

<div id="modal-auditoria-container"></div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="{{ static_v('js/modules/pasta_orcamentos/orcamento.min.js') }}"></script>
    <script src="https://unpkg.com/htmx.org@2.0.0"></script>
{% endblock %}
