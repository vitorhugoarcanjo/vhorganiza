<!-- templates/pasta_categorias/tela_categorias.html.jinja -->
{% extends "tela_base_pos_login/base.html" %}

{% block title %}Categorias - Gestão{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ static_v('css/modules/pasta_categorias/categorias.min.css') }}">
{% endblock %}

{% block content %}
<div class="painel-container">

    <!-- ========================================================== -->
    <!-- FILTROS                                                     -->
    <!-- ========================================================== -->
    <div class="painel-topo-fixo">
        <form id="form-filtros-categorias"
              hx-post="{{ url_for('categorias.ini_categorias') }}"
              hx-target="#tabela-container"
              hx-swap="outerHTML"
              class="form-filtros-total">

            <div class="filtros-container">

                <div class="bloco-filtro bloco-pesquisa-fim">
                    <div>
                        <div class="bloco-titulo">🔍 BUSCAR</div>
                        <input type="text" name="descricao" class="form-control" placeholder="buscar categoria..."
                               value="{{ descricao_filtro or '' }}">
                    </div>

                    <div style="margin-top: 4px;">
                        <label class="text-white-50" style="font-size: var(--fs-micro); display:block; margin-bottom:1px;">Mostrar:</label>
                        <div class="flex-row gap-1" id="botoes-categorias">
                            <button type="button"
                                    class="btn-filter flex-fill {% if mostrar_inativas == '0' %}btn-active-toggle{% endif %}"
                                    hx-post="{{ url_for('categorias.ini_categorias') }}"
                                    hx-vals='{"mostrar_inativas": "0"}'
                                    hx-target="#tabela-container"
                                    hx-swap="outerHTML">Ativas
                            </button>

                            <button type="button"
                                    class="btn-filter flex-fill {% if mostrar_inativas == '1' %}btn-active-toggle{% endif %}"
                                    hx-post="{{ url_for('categorias.ini_categorias') }}"
                                    hx-vals='{"mostrar_inativas": "1"}'
                                    hx-target="#tabela-container"
                                    hx-swap="outerHTML">Inativas
                            </button>

                            <button type="button"
                                    class="btn-filter flex-fill {% if mostrar_inativas == '2' %}btn-active-toggle{% endif %}"
                                    hx-post="{{ url_for('categorias.ini_categorias') }}"
                                    hx-vals='{"mostrar_inativas": "2"}'
                                    hx-target="#tabela-container"
                                    hx-swap="outerHTML">Todas
                            </button>
                        </div>
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 6px;">
                        <a href="{{ url_for('categorias.limpar_filtros') }}" class="btn-pure flex-fill" style="text-align: center;">Limpar</a>
                        <button type="submit" class="btn-pure btn-primary-pure flex-fill">Consultar</button>
                    </div>

                    <input type="hidden" name="mostrar_inativas" id="mostrar_inativas_input" value="{{ mostrar_inativas }}">
                </div>

            </div>
        </form>
    </div>

    <!-- ========================================================== -->
    <!-- TABELA (partial) - 2 BOXES                                 -->
    <!-- ========================================================== -->
    {% include 'pasta_categorias/_tabela_categorias.html.jinja' %}

</div>


<!-- ========================================================== -->
<!-- FOOTER FIXO                                                 -->
<!-- ========================================================== -->
<div class="footer-fixo-padrao">
    <div class="botoes-footer-padrao">
        <button type="button"
                class="btn-footer btn-footer-primary"
                hx-get="{{ url_for('categorias.insert_categorias.nova_categoria_modal', modulo='tarefas') }}"
                hx-target="#modal-nova-container"
                hx-swap="innerHTML"
                title="Nova Categoria">
            <i class="bi bi-plus-lg"></i>
            <span>NOVO</span>
        </button>
    </div>

    <div>
        <h2>CATEGORIAS</h2>
    </div>

    <div class="totalizador-footer-padrao">
        <div class="total-item-footer">
            <label>🏷️ TAREFAS</label>
            <span>{{ contadores.tarefas }}</span>
        </div>
        <div class="total-item-footer">
            <label>💰 FINANÇAS</label>
            <span>{{ contadores.financas }}</span>
        </div>
        <div class="contador-footer">
            <i class="bi bi-list-ul"></i>
            <span>{{ categorias_tarefas|length + categorias_financas|length }} categorias</span>
        </div>
    </div>
</div>


<!-- ========================================================== -->
<!-- CONTAINERS DOS MODAIS                                       -->
<!-- ========================================================== -->
<div id="modal-nova-container"></div>
<div id="modal-editar-container"></div>
<div id="modal-auditoria-container"></div>

<!-- Modais fixos (excluir / reativar) -->
{% include 'pasta_categorias/modais/modal_excluir_categoria.html.jinja' %}
{% include 'pasta_categorias/modais/modal_reativar_categoria.html.jinja' %}

{% endblock %}


{% block scripts %}
<script src="{{ static_v('js/modules/pasta_categorias/categorias.min.js') }}"></script>
{% endblock %}