<!-- templates/pasta_categorias/modais/modal_editar_categoria.html.jinja -->
<div class="fin-modal-overlay active" id="modalEditarCategoria">
    <div class="fin-modal-box">
        <div class="fin-modal-header">
            <h3><i class="bi bi-pencil"></i> Editar Categoria #{{ categoria.sequencia }}</h3>
            <button class="fin-btn-close-modal" onclick="fecharModalEditarCategoria()">✕</button>
        </div>

        <form id="formEditarCategoria" class="fin-modal-form">
            <input type="hidden" id="editarCategoriaId" value="{{ categoria.id }}">

            <div class="fin-modal-body">

                <div class="form-group">
                    <label>Nome *</label>
                    <input type="text"
                           id="editarCategoriaNome"
                           name="nome"
                           class="form-input"
                           value="{{ categoria.nome }}"
                           maxlength="100">
                </div>

                <div class="form-group">
                    <label>Cor</label>
                    <input type="color"
                           id="editarCategoriaCor"
                           name="cor"
                           class="form-input"
                           value="{{ categoria.cor }}">
                </div>

                <div class="form-group">
                    <label>Módulo</label>
                    <input type="text"
                           class="form-input"
                           value="{% if categoria.modulo == 'tarefas' %}📋 Tarefas{% else %}💰 Finanças{% endif %}"
                           disabled>
                </div>

            </div>

            <div class="footer-fixo-padrao">
                <div class="botoes-footer-padrao">
                    <button type="submit" class="btn-footer btn-footer-primary">
                        <i class="bi bi-check-lg"></i> SALVAR
                    </button>
                    <button type="button" class="btn-footer-cancelar" onclick="fecharModalEditarCategoria()">
                        <i class="bi bi-x-circle"></i> CANCELAR
                    </button>
                </div>
                <h2>EDITAR - CATEGORIA</h2>
            </div>
        </form>
    </div>
</div>