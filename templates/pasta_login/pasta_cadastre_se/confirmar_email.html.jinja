<!-- templates\pasta_login\pasta_cadastre_se\confirmar_email.html.jinja -->
{% extends "pasta_base_pre_login/base_pre_acesso.html" %}

{% block title %}Vhorganiza - Confirme seu Email{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ static_v('css/modules/pasta_pre_login/auth.min.css') }}">
{% endblock %}

{% block content %}
<div class="apl-container">

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            <div class="apl-flash-wrapper">
                {% for category, message in messages %}
                    <div class="apl-alert apl-alert-{{ 'danger' if category == 'error' else category }}">
                        <span>{{ message }}</span>
                        <button type="button" class="apl-close-alert-btn"
                                onclick="this.parentElement.remove()">✕</button>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endwith %}

    <div class="apl-card">
        <div class="apl-card-header">
            <h2>📧 Confirme seu Email</h2>
            <p>Enviamos um código de 6 dígitos para seu email.<br>Digite abaixo para ativar sua conta.</p>
        </div>

        <form method="POST" action="{{ url_for('cadastre_se.validar_codigo') }}" class="apl-form">
            <input type="hidden" name="user_id" value="{{ user_id }}">

            <div class="apl-input-group">
                <label for="codigo">Código de 6 dígitos:</label>
                <input type="text" id="codigo" name="codigo"
                       class="apl-code-input" maxlength="6"
                       placeholder="000000" required>
            </div>

            <div class="apl-form-actions">
                <button type="submit" class="apl-btn-submit">Verificar</button>
            </div>

            <div class="apl-form-navigation">
                <a href="{{ url_for('cadastre_se.reenviar_codigo', user_id=user_id) }}"
                   class="apl-nav-btn-secondary">Reenviar código</a>
                <a href="{{ url_for('cadastre_se.tela_cadastre_se') }}"
                   class="apl-nav-btn-secondary">Voltar</a>
            </div>
        </form>
    </div>

</div>
{% endblock %}