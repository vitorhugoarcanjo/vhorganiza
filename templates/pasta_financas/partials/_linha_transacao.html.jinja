{# templates\pasta_financas\partials\_linha_transacao.html.jinja --> #}
{# Partial: 1 linha da tabela de transações #}
<tr class="{% if transacao['ativa'] == 0 %}transacao-inativa opacity-50{% endif %}"
    id="linha-transacao-{{ transacao['sequencia_transacoes'] }}">

    <!-- SEQ -->
    <td class="td-id">{{ transacao['sequencia_transacoes'] }}</td>

    <!-- TIPO -->
    <td>
        {% if transacao['tipo'] == 'receita' %}
            <span class="badge-pure bg-success">📈 Receita</span>
        {% else %}
            <span class="badge-pure bg-warning text-dark">📉 Despesa</span>
        {% endif %}
    </td>

    <!-- VALOR -->
    <td class="td-titulo">
        {% if transacao['valor'] is number %}
            R$ {{ "%.2f"|format(transacao['valor'])|replace('.', ',') }}
        {% else %}
            {{ transacao['valor'] }}
        {% endif %}
    </td>

    <!-- DESCRIÇÃO -->
    <td class="td-titulo" title="{{ transacao['descricao'] }}">{{ transacao['descricao'] }}</td>

    <!-- STATUS -->
    <td>
        {% if transacao['status'] == 'aberto' %}
            <span class="badge-pure bg-danger">🔴 Aberto</span>
        {% elif transacao['status'] == 'quitado' %}
            <span class="badge-pure bg-success">✅ Quitado</span>
        {% else %}
            <span class="badge-pure bg-success">💰 Recebido</span>
        {% endif %}
    </td>

    <!-- CATEGORIA -->
    <td>
        {% if transacao['categoria_nome'] %}
            <span class="badge-pure tag-categoria" style="background-color: {{ transacao['categoria_cor'] or '#6c757d' }}; color: white; border: none;">
                {{ transacao['categoria_nome'] }}
            </span>
        {% else %}
            <span class="text-vazio">-</span>
        {% endif %}
    </td>

    <!-- EMISSÃO -->
    <td>{{ transacao['data_emissao'] or '-' }}</td>

    <!-- VENCIMENTO -->
    <td>{{ transacao['data_vencimento'] or '-' }}</td>

    <!-- AÇÕES -->
    <td class="td-acoes text-center">
        <!-- DETALHES -->
        <button type="button" class="btn-acao view" title="Ver detalhes"
                onclick="verDetalhesTransacao({{ transacao['sequencia_transacoes'] }})">
            <i class="bi bi-eye"></i>
        </button>

        <!-- AUDITORIA -->
        <button type="button"
                class="btn-acao audit"
                hx-get="{{ url_for('auditoria.historico_transacao', transacao_id=transacao['sequencia_transacoes']) }}"
                hx-target="#modal-auditoria-container"
                hx-swap="innerHTML"
                title="Ver histórico de alterações">
            <i class="bi bi-clock-history"></i>
        </button>

        {% if transacao['ativo'] == 1 %}
            {% if transacao['status'] not in ['quitado', 'recebido'] %}
                <!-- EDITAR -->
                <button type="button"
                        class="btn-acao edit"
                        hx-get="{{ url_for('financas.edit_transacoes.editar_modal', sequencia=transacao['sequencia_transacoes']) }}"
                        hx-target="#modal-editar-container"
                        hx-swap="innerHTML"
                        title="Editar">
                    <i class="bi bi-pencil"></i>
                </button>

                <!-- EXCLUIR -->
                <button type="button"
                        class="btn-acao delete btn-excluir"
                        data-id="{{ transacao['sequencia_transacoes'] }}"
                        data-desc="{{ transacao['descricao'] }}"
                        title="Excluir">
                    <i class="bi bi-trash"></i>
                </button>

                <!-- QUITAR / RECEBER -->
                {% if transacao['status'] == 'aberto' %}
                    <button type="button"
                            class="btn-acao check btn-quitar"
                            hx-post="{{ url_for('financas.quitar_transacao.quitar_transacao_view', sequencia=transacao['sequencia_transacoes']) }}"
                            hx-target="closest tr"
                            hx-swap="outerHTML"
                            hx-indicator="this"
                            data-id="{{ transacao['sequencia_transacoes'] }}"
                            title="{{ 'Quitar' if transacao['tipo'] == 'despesa' else 'Receber' }}">
                        <i class="bi {{ 'bi-check-lg' if transacao['tipo'] == 'despesa' else 'bi-cash-stack' }}"></i>
                    </button>
                {% endif %}
            {% else %}
                <!-- ESTORNAR -->
                <button type="button"
                        class="btn-acao undo btn-estornar"
                        data-id="{{ transacao['sequencia_transacoes'] }}"
                        data-desc="{{ transacao['descricao'] }}"
                        data-tipo="{{ transacao['tipo'] }}"
                        title="Estornar">
                    <i class="bi bi-arrow-return-left"></i>
                </button>
            {% endif %}
        {% else %}
            <!-- REATIVAR -->
            <button type="button"
                    class="btn-acao reativar btn-reativar"
                    data-id="{{ transacao['sequencia_transacoes'] }}"
                    data-desc="{{ transacao['descricao'] }}"
                    title="Reativar">
                <i class="bi bi-arrow-repeat"></i>
            </button>
        {% endif %}
    </td>
</tr>