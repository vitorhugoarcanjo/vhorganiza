<!-- ========================================================== -->
<!-- PARTIAL: CAMPOS DA TRANSAÇÃO (NOVO / EDIT) - v2             -->
<!-- Sem IDs globais. Tudo via .js-* para o TransacaoForm achar. -->
<!-- ========================================================== -->

<div class="form-body">

    <!-- LINHA 1: TIPO + CATEGORIA + DESCRIÇÃO -->
    <div class="form-grid">
        <div class="form-group">
            <label>Tipo</label>
            <div class="tipo-container">
                <button type="button" class="tipo-btn js-tipo-btn" data-tipo="vazio" disabled>
                    <i class="bi bi-question-circle"></i> Sel.
                </button>
                <button type="button" class="tipo-btn receita js-tipo-btn" data-tipo="receita">
                    <i class="bi bi-arrow-up-circle-fill"></i> Receita
                </button>
                <button type="button" class="tipo-btn despesa js-tipo-btn" data-tipo="despesa">
                    <i class="bi bi-arrow-down-circle-fill"></i> Despesa
                </button>
            </div>
            <input type="hidden" name="tipo" class="js-tipo-hidden" value="">
        </div>

        <div class="form-group">
            <label>Categoria</label>
            <select name="categoria_id" class="form-select js-categoria">
                <option value="">Selecione...</option>
                {% for cat in categorias %}
                    <option value="{{ cat[0] }}">{{ cat[1] }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group descricao-full">
            <label>Descrição</label>
            <input type="text"
                   name="descricao"
                   class="form-input js-descricao"
                   placeholder="Ex: Salário, Supermercado...">
        </div>
    </div>

    <!-- LINHA 2: VALOR + PARCELAS + EMISSÃO + VENCIMENTO -->
    <div class="form-grid-4">
        <div class="form-group">
            <label>Valor Total</label>
            <input type="text"
                   name="valor_total"
                   class="form-input money-input js-valor-total"
                   value="0,00">
        </div>

        <div class="form-group">
            <label>Nº Parcelas</label>
            <input type="number"
                   name="total_parcelas"
                   class="form-input js-total-parcelas"
                   value="1"
                   min="1"
                   max="100"
                   inputmode="numeric"
                   style="text-align: center;">
        </div>

        <div class="form-group">
            <label>Data Emissão</label>
            <input type="date"
                   name="data_emissao"
                   class="form-input js-data-emissao"
                   value="{{ hoje }}">
        </div>

        <div class="form-group">
            <label>Data Vencimento</label>
            <input type="date"
                   name="data_vencimento"
                   class="form-input js-data-vencimento"
                   value="{{ hoje }}">
        </div>
    </div>

    <!-- CONFIGURAÇÕES DE PARCELAS (só o intervalo — sem 1º vencimento) -->
    <div class="parcelas-config-area js-parcelas-config" style="display: none;">
        <div class="parcelas-config-painel">
            <div class="parcelas-config-row">
                <div class="parcelas-config-item">
                    <label>Intervalo entre parcelas</label>
                    <div style="display: flex; gap: 6px;">
                        <input type="number"
                               name="intervalo_dias"
                               class="form-input js-intervalo-dias"
                               value="30" min="1" max="365" inputmode="numeric"
                               style="flex: 1;">
                        <span style="display: flex; align-items: center; color: var(--texto-mutado);">dias</span>
                    </div>
                </div>
                <div class="parcelas-config-item">
                    <label>&nbsp;</label>
                    <button type="button" class="btn-distribuir js-btn-distribuir">
                        <i class="bi bi-calculator"></i> Distribuir igualmente
                    </button>
                </div>
            </div>
        </div>
    </div>

        <!-- TABELA DE PARCELAS -->
    <div class="parcelas-wrapper js-parcelas-wrapper" style="display: none;">
        <div class="parcelas-table-wrapper">
            <table class="parcelas-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Parcela</th>
                        <th style="width: 160px;">Valor (R$)</th>
                        <th style="width: 160px;">Vencimento</th>
                    </tr>
                </thead>
                <tbody class="js-parcelas-body">
                    <tr><td colspan="3" class="parcelas-vazio">Selecione mais de 1 parcela</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</div>