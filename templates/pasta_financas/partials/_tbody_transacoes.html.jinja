{# templates\pasta_financas\partials\_tbody_transacoes.html.jinja #}
{# Partial: <tbody> com todas as linhas da tabela #}
<tbody id="tbody-transacoes">
    {% if transacoes %}
        {% for transacao in transacoes %}
            {% include 'pasta_financas/partials/_linha_transacao.html.jinja' %}
        {% endfor %}
    {% else %}
        <tr>
            <td colspan="9" class="text-center py-4 text-white-50">Nenhuma transação cadastrada ou encontrada para este período.</td>
        </tr>
    {% endif %}
</tbody>