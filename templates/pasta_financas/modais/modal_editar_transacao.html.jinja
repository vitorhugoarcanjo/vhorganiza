<!-- ========================================================== -->
<!-- MODAL: EDITAR TRANSAÇÃO - v2                                -->
<!-- ========================================================== -->
<div class="fin-modal-overlay active" id="modalEditarTransacao" style="display: flex;">
    <div class="fin-modal-box">

        <div class="fin-modal-header">
            <div class="fin-modal-header-left">
                <h3 id="finEditarSequencia">Editar Transação #{{ sequencia }}</h3>
            </div>

            <div class="fin-modal-header-right">
                <button type="button" class="fin-btn-close-modal" onclick="fecharModalEditarTransacao()" title="Fechar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <form id="formEditarTransacao"
              class="fin-modal-form"
              data-transacao-id="{{ sequencia }}"
              onsubmit="event.preventDefault(); salvarEditarTransacao();">

            <div class="fin-modal-body">
                {% set hoje = hoje or '' %}
                {% set categorias = categorias or [] %}
                {% include 'pasta_financas/partials/form_transacao.html.jinja' %}
            </div>

            <div class="footer-fixo-padrao" id="footerFixoEditar">
                <div class="botoes-footer-padrao">
                    <button type="submit" class="btn-footer btn-footer-primary">
                        <i class="bi bi-save"></i> ATUALIZAR
                    </button>
                    <button type="button" class="btn-footer-cancelar" onclick="fecharModalEditarTransacao()">
                        <i class="bi bi-x-circle"></i> CANCELAR
                    </button>
                </div>

                <h2>EDITAR - TRANSAÇÃO</h2>

                <div class="totalizador-footer-padrao">
                    <div class="total-item-footer valor-original">
                        <label>Valor Total:</label>
                        <span class="js-total-original">R$ 0,00</span>
                    </div>
                    <div class="total-item-footer soma-parcelas">
                        <label>Soma Parcelas:</label>
                        <span class="js-soma-parcelas">R$ 0,00</span>
                    </div>
                    <div class="total-item-footer diferenca">
                        <label>Diferença:</label>
                        <span class="js-diferenca-valor">R$ 0,00</span>
                    </div>
                </div>
            </div>

        </form>

    </div>
</div>