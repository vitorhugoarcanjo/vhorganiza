{# templates/pasta_dashboard/tela_dashboard.html.jinja #}
{% extends "tela_base_pos_login/base.html" %}

{% block title %}Dashboard - VHORGANIZA{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ static_v('css/modules/pasta_dashboard/dashboard.min.css') }}">
{% endblock %}

{% block content %}
<div class="painel-container">

    <!-- FILTROS (padrão Finanças) -->
    <div class="painel-topo-fixo">
        <form id="form-filtros-dashboard"
              hx-post="{{ url_for('dashboard.inidashboard') }}"
              hx-target="#tabela-container"
              hx-swap="outerHTML"
              class="form-filtros-total">

            <div class="filtros-container">
                <div class="bloco-filtro">
                    <div class="bloco-titulo">📅 PERÍODO</div>

                    <div class="flex-row gap-1">
                        <button type="submit" name="tipo_filtro" value="ontem" class="btn-pure flex-fill">-1 DIA</button>
                        <button type="submit" name="tipo_filtro" value="hoje"  class="btn-pure btn-success-pure flex-fill">HOJE</button>
                        <button type="submit" name="tipo_filtro" value="amanha" class="btn-pure flex-fill">+1 DIA</button>
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 2px;">
                        <button type="submit" name="tipo_filtro" value="mes_passado" class="btn-pure flex-fill">-1 MÊS</button>
                        <button type="submit" name="tipo_filtro" value="mes"         class="btn-pure btn-info-pure flex-fill">I/F MÊS</button>
                        <button type="submit" name="tipo_filtro" value="mes_proximo" class="btn-pure flex-fill">+1 MÊS</button>
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 3px;">
                        <input type="date" name="data_inicio" id="data_inicio_input"
                               class="form-control flex-fill" value="{{ data_inicio or '' }}">
                        <input type="date" name="data_fim" id="data_fim_input"
                               class="form-control flex-fill" value="{{ data_fim or '' }}">
                    </div>

                    <div class="flex-row gap-1" style="margin-top: 3px;">
                        <a href="{{ url_for('dashboard.limpar_filtros') }}" class="btn-pure flex-fill" style="text-align: center;">Limpar</a>
                        <button type="submit" class="btn-pure btn-primary-pure flex-fill">Consultar</button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- ÁREA PRINCIPAL -->
    {% include 'pasta_dashboard/partials/_tabela_wrapper.html.jinja' %}

</div>
{% endblock %}