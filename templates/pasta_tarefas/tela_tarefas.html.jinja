<!-- templates/pasta_tarefas/tela_tarefas.html.jinja -->
{% extends "tela_base_pos_login/base.html" %}

{% block title %}Gestão de Tarefas{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ static_v('css/modules/pasta_tarefas/tarefas.min.css') }}">
{% endblock %}

{% block content %}
<div class="painel-container">

    <!-- ========================================================== -->
    <!-- FILTROS                                                     -->
    <!-- ========================================================== -->
    <div class="painel-topo-fixo">
        <form id="formFiltrosTarefas"
              hx-post="{{ url_for('tarefas.ini_tarefas') }}"
              hx-target="#tabela-container"
              hx-swap="outerHTML"
              class="form-filtros-total">
            <div class="filtros-container">

                <div class="bloco-filtro">
                    <div class="bloco-titulo">📅 DATA</div>
                    <div class="flex-row gap-1">
                        <button type="submit" name="tipo_filtro" value="ontem" class="btn-pure flex-fill">-1</button>
                        <button type="submit" name="tipo_filtro" value="hoje" class="btn-pure btn-success-pure flex-fill">HOJE</button>
                        <button type="submit" name="tipo_filtro" value="amanha" class="btn-pure flex-fill">+1</button>
                    </div>
                    <div class="flex-row gap-1" style="margin-top: 2px;">
                        <button type="submit" name="tipo_filtro" value="mes_passado" class="btn-pure flex-fill">-1m</button>
                        <button type="submit" name="tipo_filtro" value="mes" class="btn-pure btn-info-pure flex-fill">I/F</button>
                        <button type="submit" name="tipo_filtro" value="mes_proximo" class="btn-pure flex-fill">+1m</button>
                    </div>
                    <div class="flex-row gap-1" style="margin-top: 3px;">
                        <div class="flex-fill">
                            <input type="date" name="data_inicio" id="data_inicio_input" class="form-control"
                                   value="{{ data_inicio or '' }}">
                        </div>
                        <div class="flex-fill">
                            <input type="date" name="data_fim" id="data_fim_input" class="form-control"
                                   value="{{ data_fim or '' }}">
                        </div>
                    </div>
                    <div style="margin-top: 3px;">
                        <select name="tipo_data" class="form-select">
                            <option value="inicio"      {% if tipo_data == 'inicio' %}selected{% endif %}>📅 DATA INICIO</option>
                            <option value="final"       {% if tipo_data == 'final' %}selected{% endif %}>⏰ DATA FINAL</option>
                            <option value="finalizacao" {% if tipo_data == 'finalizacao' %}selected{% endif %}>✅ DATA FINALIZAÇÃO</option>
                        </select>
                    </div>
                    <input type="hidden" name="mostrar_inativas" id="mostrar_inativas_input" value="{{ mostrar_inativas }}">
                </div>

                <div class="bloco-filtro">
                    <div class="bloco-titulo">🏷️ CATEGORIAS</div>
                    <div class="lista-categorias scroll-fino">
                        <label class="label-categoria">
                            <input type="checkbox" name="categorias" value="null" class="me-1"
                                   {% if categorias_filtro and 'null' in categorias_filtro %}checked{% endif %}>
                            <span class="span_categorias">📭 SEM CATEGORIA</span>
                        </label>
                        {% for cat in categorias_usuario %}
                        <label class="label-categoria">
                            <input type="checkbox" name="categorias" value="{{ cat[0] }}" class="me-1"
                                   {% if categorias_filtro and cat[0]|string in categorias_filtro %}checked{% endif %}>
                            <span class="span_categorias" style="color: {{ cat[2] }}; font-weight: 500;">{{ cat[1] }}</span>
                        </label>
                        {% endfor %}
                    </div>
                </div>

                <div class="bloco-filtro">
                    <div class="bloco-titulo">📊 OUTROS FILTROS</div>

                    <div class="flex-row gap-2">
                        <div class="flex-fill">
                            <label class="text-white-50" style="font-size: var(--fs-micro); display:block; margin-bottom:1px;">Status</label>
                            <select name="status" class="form-select">
                                <option value="" {% if status_filtro == '' %}selected{% endif %}>Todos</option>
                                <option value="vazio" {% if status_filtro == 'vazio' %}selected{% endif %}>📋 Vazio</option>
                                <option value="pendente" {% if status_filtro == 'pendente' %}selected{% endif %}>⏰ Pendente</option>
                                <option value="em andamento" {% if status_filtro == 'em andamento' %}selected{% endif %}>⏳ Andamento</option>
                                <option value="concluido" {% if status_filtro == 'concluido' %}selected{% endif %}>✅ Concluído</option>
                                <option value="pendente_em_andamento" {% if status_filtro == 'pendente_em_andamento' %}selected{% endif %}>🔄 Pend+Andam</option>
                            </select>
                        </div>

                        <div class="flex-fill">
                            <label class="text-white-50" style="font-size: var(--fs-micro); display:block; margin-bottom:1px;">Prioridade</label>
                            <select name="prioridade" class="form-select">
                                <option value="" {% if prioridade_filtro == '' %}selected{% endif %}>Todos</option>
                                <option value="vazio" {% if prioridade_filtro == 'vazio' %}selected{% endif %}>📋 Vazio</option>
                                <option value="baixa" {% if prioridade_filtro == 'baixa' %}selected{% endif %}>🟢 Baixa</option>
                                <option value="media" {% if prioridade_filtro == 'media' %}selected{% endif %}>🟡 Média</option>
                                <option value="alta" {% if prioridade_filtro == 'alta' %}selected{% endif %}>🔴 Alta</option>
                            </select>
                        </div>
                    </div>

                    <div style="margin-top: 4px;">
                        <label class="text-white-50" style="font-size: var(--fs-micro); display:block; margin-bottom:1px;">Tarefa:</label>
                        <div class="flex-row gap-1" id="botoes-transacao">
                            <button type="button"
                                    class="btn-filter flex-fill {% if mostrar_inativas == '0' %}btn-active-toggle{% endif %}"
                                    hx-post="{{ url_for('tarefas.ini_tarefas') }}"
                                    hx-vals='{"mostrar_inativas": "0"}'
                                    hx-target="#tabela-container"
                                    hx-swap="outerHTML">Ativas</button>
                            <button type="button"
                                    class="btn-filter flex-fill {% if mostrar_inativas == '1' %}btn-active-toggle{% endif %}"
                                    hx-post="{{ url_for('tarefas.ini_tarefas') }}"
                                    hx-vals='{"mostrar_inativas": "1"}'
                                    hx-target="#tabela-container"
                                    hx-swap="outerHTML">Inativas</button>
                            <button type="button"
                                    class="btn-filter flex-fill {% if mostrar_inativas == '2' %}btn-active-toggle{% endif %}"
                                    hx-post="{{ url_for('tarefas.ini_tarefas') }}"
                                    hx-vals='{"mostrar_inativas": "2"}'
                                    hx-target="#tabela-container"
                                    hx-swap="outerHTML">Todas</button>
                        </div>
                    </div>
                </div>

                <div class="bloco-filtro bloco-pesquisa-fim">
                    <div>
                        <div class="bloco-titulo">🔍 DESCRIÇÃO</div>
                        <input type="text" name="descricao" class="form-control" placeholder="buscar..."
                               value="{{ descricao_filtro or '' }}">
                    </div>
                    <div class="flex-row gap-1" style="margin-top: 6px;">
                        <a href="{{ url_for('tarefas.limpar_filtros') }}" class="btn-pure flex-fill" style="text-align: center;">Limpar Todos</a>
                        <button type="submit" class="btn-pure btn-primary-pure flex-fill">Consultar</button>
                    </div>
                </div>

            </div>
        </form>
    </div>

    <!-- ========================================================== -->
    <!-- TABELA (partial)                                            -->
    <!-- ========================================================== -->
    {% include 'pasta_tarefas/_tabela_tarefas.html.jinja' %}
</div>


<!-- ========================================================== -->
<!-- FOOTER FIXO                                                 -->
<!-- ========================================================== -->
<div class="footer-fixo-padrao">
    <div class="botoes-footer-padrao">
        <button type="button"
                class="btn-footer btn-footer-primary"
                hx-get="{{ url_for('tarefas.insert_tarefas.nova_tarefa_modal') }}"
                hx-target="#modal-nova-container"
                hx-swap="innerHTML"
                title="Nova Tarefa">
            <i class="bi bi-plus-lg"></i>
            <span>NOVO</span>
        </button>
        <a href="{{ url_for('categorias.insert_categorias_global') }}" class="btn-footer btn-footer-secondary" title="Categorias">
            <i class="bi bi-tags"></i>
            <span>CATEGORIAS</span>
        </a>
    </div>

    <div>
        <h2>TAREFAS</h2>
    </div>

    <div class="totalizador-footer-padrao">
        <div class="total-item-footer total-pendente">
            <label>⏰ PENDENTES</label>
            <span id="totalPendentes">{{ contadores.pendentes }}</span>
        </div>
        <div class="total-item-footer total-andamento">
            <label>⏳ ANDAMENTO</label>
            <span id="totalAndamento">{{ contadores.andamento }}</span>
        </div>
        <div class="total-item-footer total-concluidas">
            <label>✅ CONCLUÍDAS</label>
            <span id="totalConcluidas">{{ contadores.concluidas }}</span>
        </div>
        <div class="contador-footer">
            <i class="bi bi-list-ul"></i>
            <span>{{ tarefas|length }} tarefas</span>
        </div>
    </div>
</div>


<!-- ========================================================== -->
<!-- CONTAINERS DOS MODAIS                                       -->
<!-- ========================================================== -->
<div id="modal-nova-container"></div>
<div id="modal-editar-container"></div>
<div id="modal-auditoria-container"></div>

<!-- Modais fixos (concluir / excluir / detalhes) -->
{% include 'pasta_tarefas/modais/concluir_tarefa.html' %}
{% include 'pasta_tarefas/modais/detalhes_completo.html' %}
{% include 'pasta_tarefas/modais/excluir_tarefa.html' %}
{% include 'pasta_tarefas/modais/reabrir_tarefa.html' %}
{% include 'pasta_tarefas/modais/reativar_tarefa.html' %} 

{% endblock %}


{% block scripts %}
<script src="{{ static_v('js/modules/pasta_tarefas/tarefas.min.js') }}"></script>
{% endblock %}